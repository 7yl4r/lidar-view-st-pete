{
  "name": "lidar-viewer-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "CesiumJS scene player for St. Petersburg, FL LiDAR / modeling data (Phase 0 scaffold)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bake:terrain": "python3 scripts/bake_terrain.py",
    "bake:dem": "python3 scripts/bake_dem_terrain.py",
    "bake:pointcloud": "python3 scripts/bake_pointcloud.py"
  },
  "dependencies": {
    "cesium": "^1.128.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-cesium": "^1.2.23",
    "vitest": "^2.1.8"
  }
}
